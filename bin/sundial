#!/usr/bin/env node
// sundial — install, run, migrate and remove Sundial on this Mac.
//
// Plain Node, no dependencies, no build step: this is the file a stranger runs
// before anything is built. Every path it touches comes from four variables,
// so a test install never shares anything with a real one:
//
//   SUNDIAL_HOME        data folder            (default ~/.sundial)
//   SUNDIAL_LABEL       LaunchAgent label      (default dev.sundial.agent)
//   SUNDIAL_WEB_PORT    web client port        (default 3080)
//   SUNDIAL_PHONE_PORT  phone ingest port      (default 8767)
//
// Uninstall deletes only what install wrote, and only in a folder that holds
// this installer's marker for THAT folder. The marker is written before
// anything else, so a half-finished install can still be removed.
import { spawnSync } from 'node:child_process';
import crypto from 'node:crypto';
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import readline from 'node:readline/promises';
import { fileURLToPath } from 'node:url';

const REPO = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
const HOME = process.env.SUNDIAL_HOME || path.join(os.homedir(), '.sundial');
// A test or custom install remembers its label and ports in its marker, so
// `open`, `status` and `restart` find it again without the variables.
const SAVED = (() => {
  try {
    const marker = JSON.parse(fs.readFileSync(path.join(HOME, '.sundial-install.json'), 'utf8'));
    return marker?.tool === 'sundial' ? marker : {};
  } catch {
    return {};
  }
})();
const LABEL = process.env.SUNDIAL_LABEL || SAVED.label || 'dev.sundial.agent';
const WEB_PORT = Number(process.env.SUNDIAL_WEB_PORT || SAVED.webPort || 3080);
const PHONE_PORT = Number(process.env.SUNDIAL_PHONE_PORT || SAVED.phonePort || 8767);
const MARKER = path.join(HOME, '.sundial-install.json');
const PLIST = path.join(os.homedir(), 'Library', 'LaunchAgents', `${LABEL}.plist`);
const DSH_HOME = path.join(HOME, 'dsh');
const PROFILE = path.join(DSH_HOME, 'profiles', 'web');
/** The bundle inside the data folder: where a test or LaunchAgent install keeps it, and where the real one lived before 2026-09-26. */
const HOME_APP = path.join(HOME, 'Sundial.app');
/** The real app install lives in /Applications, so it is in the Mac's app list; everything else keeps it in the data folder. */
const APP = process.env.SUNDIAL_APP_PATH || SAVED.app || (LABEL === 'dev.sundial.agent' && !process.argv.includes('--no-app') && process.platform === 'darwin' ? '/Applications/Sundial.app' : HOME_APP);
/** The bundle id: the real install keeps its TCC rows; a test label gets its own, so the two never share grants or a login item. */
const BUNDLE_ID = LABEL === 'dev.sundial.agent' ? 'dev.sundial.daemon' : LABEL;
/** How this install runs: the Mac app (default on macOS since Phase 1) or the older LaunchAgent. */
// An agent install the app took over (Sundial.swift, takeOverLaunchAgent) still says 'agent' in its marker.
const appMode = () => (SAVED.mode ?? 'agent') === 'app' || appPid() !== null;
const UID = process.getuid?.() ?? 0;
/** The Node that starts the Swift helpers. See the note in start.sh. */
const SIDECAR_NODE = process.env.SUNDIAL_SIDECAR_NODE || process.execPath;

/** Plugin folders, in the order dsh must mount them. */
const PLUGINS = ['llm-openai', 'db', 'memory', 'kernel', 'sensors', 'tools', 'proactive', 'theme', 'actions', 'web-browser'];

/** Folders no command may ever write to or delete, whatever SUNDIAL_HOME says. */
const PROTECTED = new Set([
  '/',
  os.homedir(),
  path.join(os.homedir(), '.gnomon'),
  path.join(os.homedir(), '.dsh'),
  path.join(os.homedir(), 'Library'),
  REPO,
]);

const args = process.argv.slice(3);
const flag = (name) => args.includes(`--${name}`);
const option = (name) => {
  const i = args.indexOf(`--${name}`);
  return i >= 0 ? args[i + 1] : undefined;
};

const say = (line = '') => console.log(line);
const fail = (line) => {
  console.error(`sundial: ${line}`);
  process.exit(1);
};

function run(cmd, cmdArgs, opts = {}) {
  const result = spawnSync(cmd, cmdArgs, { stdio: opts.quiet ? 'pipe' : 'inherit', encoding: 'utf8', ...opts });
  if (opts.check !== false && result.status !== 0) {
    fail(`${cmd} ${cmdArgs.join(' ')} failed (exit ${result.status})${opts.quiet ? `\n${result.stderr ?? ''}` : ''}`);
  }
  return result;
}

const has = (cmd) => spawnSync('/bin/sh', ['-c', `command -v ${cmd}`], { stdio: 'ignore' }).status === 0;

function assertSafeHome() {
  const resolved = path.resolve(HOME);
  if (!path.isAbsolute(HOME)) fail(`SUNDIAL_HOME must be an absolute path (got ${HOME}).`);
  if (PROTECTED.has(resolved) || resolved.split(path.sep).length < 3) fail(`refusing to use ${resolved} as SUNDIAL_HOME.`);
}

function readMarker() {
  try {
    const marker = JSON.parse(fs.readFileSync(MARKER, 'utf8'));
    return marker?.tool === 'sundial' && marker.home === path.resolve(HOME) && typeof marker.installId === 'string' ? marker : null;
  } catch {
    return null;
  }
}

function writeMarker(extra = {}) {
  const marker = readMarker() ?? { tool: 'sundial', home: path.resolve(HOME), installId: crypto.randomUUID(), createdAt: new Date().toISOString() };
  Object.assign(marker, { repo: REPO, label: LABEL, plist: PLIST, webPort: WEB_PORT, phonePort: PHONE_PORT, updatedAt: new Date().toISOString() }, extra);
  fs.writeFileSync(MARKER, `${JSON.stringify(marker, null, 2)}\n`, { mode: 0o600 });
  return marker;
}

/** Create SUNDIAL_HOME (0700) and claim it with a marker, or confirm we already own it. */
function claimHome() {
  assertSafeHome();
  // The app writes its pid and its log before it runs `prepare`; nothing else counts as ours.
  if (fs.existsSync(HOME) && !readMarker() && fs.readdirSync(HOME).some((f) => f !== '.daemon' && f !== 'logs')) {
    fail(`${HOME} exists, is not empty, and was not made by this installer. Pick another SUNDIAL_HOME or move it away.`);
  }
  fs.mkdirSync(HOME, { recursive: true, mode: 0o700 });
  fs.chmodSync(HOME, 0o700);
  return writeMarker();
}

// ---------------------------------------------------------------------------
// doctor

// lane H (H7)
/** The install's app.env as key → value, or {} when there is none. */
function readAppEnv() {
  try {
    return Object.fromEntries(
      fs
        .readFileSync(path.join(HOME, 'app.env'), 'utf8')
        .split('\n')
        .filter((l) => /^[A-Z_]+=/.test(l))
        .map((l) => [l.slice(0, l.indexOf('=')), l.slice(l.indexOf('=') + 1)]),
    );
  } catch {
    return {};
  }
}

/** What an existing install needs to still start: the Node its app.env names. Empty before an install. */
function installChecks() {
  const env = readAppEnv();
  if (!env.SUNDIAL_NODE) return [];
  return [{ name: `app.env's Node (${env.SUNDIAL_NODE})`, ok: fs.existsSync(env.SUNDIAL_NODE), fix: 'That Node is gone (a Homebrew upgrade moves it). Run `node bin/sundial install --skip-build` with the Node you use now; it rewrites app.env and rebuilds nothing.' }];
}

function checks() {
  const node = Number(process.versions.node.split('.')[0]);
  const clt = spawnSync('xcode-select', ['-p'], { encoding: 'utf8' });
  return [
    ...installChecks(),
    { name: 'macOS', ok: process.platform === 'darwin', fix: 'Sundial runs on macOS only (the sensors are native Swift).' },
    { name: `Node.js >= 22 (found ${process.versions.node})`, ok: node >= 22, fix: 'Install Node 22 or newer: https://nodejs.org or `brew install node`.' },
    { name: 'pnpm', ok: has('pnpm'), fix: 'Install pnpm: `npm install -g pnpm` or `brew install pnpm`.' },
    { name: 'Xcode Command Line Tools', ok: clt.status === 0 && has('swiftc'), fix: 'Run `xcode-select --install`, then run this again.' },
    { name: 'sqlite3', ok: has('sqlite3'), fix: 'sqlite3 ships with macOS; check /usr/bin/sqlite3.' },
  ];
}

function doctor({ quiet = false } = {}) {
  const results = checks();
  for (const c of results) if (!quiet || !c.ok) say(`${c.ok ? '  ok ' : '  !! '} ${c.name}${c.ok ? '' : `\n       ${c.fix}`}`);
  return results.every((c) => c.ok);
}

// ---------------------------------------------------------------------------
// install

function writeIfMissing(file, content, mode = 0o600) {
  if (fs.existsSync(file)) return false;
  fs.writeFileSync(file, content, { mode });
  return true;
}

function linkForce(target, link) {
  fs.rmSync(link, { force: true, recursive: false });
  fs.symlinkSync(target, link);
}

function writeProfile() {
  fs.mkdirSync(path.join(PROFILE, 'node_modules'), { recursive: true });
  const bundles = ['@deepseek-ai/dsh-base', '@deepseek-ai/dsh-web-app'];
  for (const name of PLUGINS) {
    const dir = path.join(REPO, 'plugins', `sundial-${name}`);
    const pkg = JSON.parse(fs.readFileSync(path.join(dir, 'package.json'), 'utf8')).name;
    const link = path.join(PROFILE, 'node_modules', pkg);
    fs.mkdirSync(path.dirname(link), { recursive: true });
    linkForce(dir, link);
    bundles.push(pkg);
  }
  const manifest = { name: 'sundial-profile', private: true, dsh: { profile: { bundles } } };
  fs.writeFileSync(path.join(PROFILE, 'package.json'), `${JSON.stringify(manifest, null, 2)}\n`);
  fs.copyFileSync(path.join(REPO, 'apps', 'harness', 'profile', 'cordis.patch.yml'), path.join(PROFILE, 'cordis.patch.yml'));

  // Gnomon's agent preset. dsh skips a symlinked DIRECTORY during discovery,
  // so the entry is a real folder holding links to the repo's files.
  const preset = path.join(DSH_HOME, '.agent-presets', 'gnomon');
  fs.mkdirSync(preset, { recursive: true });
  for (const f of ['agent.cordis.yml', 'preset.yml', 'skills']) {
    linkForce(path.join(REPO, 'plugins', 'sundial-tools', 'presets', 'gnomon', f), path.join(preset, f));
  }
}

function writeStartScript({ sidecars }) {
  const script = `#!/bin/zsh
# Written by \`sundial install\`; started at login by ${LABEL}.
# 1. Start the Swift sidecar launcher (direct spawn, never \`open -a\`).
# 2. Run the web process in the foreground so launchd keeps it alive.
# Everything Sundial writes (DB, logs, sidecar JSON, screen text) is private to you.
umask 077
export PATH="${path.dirname(process.execPath)}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export SUNDIAL_HOME="${HOME}"
export DSH_HOME="${DSH_HOME}"
export DSH_TELEMETRY_DISABLED=1
export SUNDIAL_WEB_PORT=${WEB_PORT}
export SUNDIAL_PHONE_PORT=${PHONE_PORT}
export SUNDIAL_LABEL=${LABEL}
${process.env.SUNDIAL_CHROME_PORT ? `export SUNDIAL_CHROME_PORT=${Number(process.env.SUNDIAL_CHROME_PORT)}\n` : ''}${sidecars ? '' : 'export SUNDIAL_NATIVE_HELPERS=0\n'}cd "${REPO}" || exit 1
# Stop first: macOS applies a new grant only to a freshly started helper, and
# \`start\` alone does nothing while the old helpers still run.
# macOS judges Accessibility along the launch chain, and the Node that starts
# the helpers is part of it: SUNDIAL_SIDECAR_NODE picks one that holds the grant.
${sidecars ? '' : '# '}"${SIDECAR_NODE}" apps/harness/bin/sundial-sidecars.js stop >> "$SUNDIAL_HOME/logs/sidecars.log" 2>&1
${sidecars ? '' : '# '}"${SIDECAR_NODE}" apps/harness/bin/sundial-sidecars.js start >> "$SUNDIAL_HOME/logs/sidecars.log" 2>&1
cd "${REPO}/apps/harness" || exit 1
exec ./node_modules/.bin/dsh web --no-open --host 127.0.0.1 --port ${WEB_PORT}
`;
  fs.writeFileSync(path.join(HOME, 'start.sh'), script, { mode: 0o700 });
}

function plistXml() {
  const log = path.join(HOME, 'logs', 'sundial.log');
  return `<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>${LABEL}</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>${path.join(HOME, 'start.sh')}</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>WorkingDirectory</key>
  <string>${path.join(REPO, 'apps', 'harness')}</string>
  <key>StandardOutPath</key>
  <string>${log}</string>
  <key>StandardErrorPath</key>
  <string>${log}</string>
</dict>
</plist>
`;
}

/**
 * What the app runs, as start.sh runs it: `Sundial.app` reads this at launch
 * (`apps/macos/Sundial.swift`). The login item is asked for only by the real
 * install; a test install never puts itself in Login Items.
 */
function writeAppEnv({ sidecars }) {
  const lines = [
    '# Written by `sundial install`; read by Sundial.app at launch.',
    `PATH=${path.dirname(process.execPath)}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin`,
    `SUNDIAL_REPO=${REPO}`,
    `SUNDIAL_APP_PATH=${APP}`,
    `SUNDIAL_NODE=${process.execPath}`,
    `DSH_HOME=${DSH_HOME}`,
    `SUNDIAL_WEB_PORT=${WEB_PORT}`,
    `SUNDIAL_PHONE_PORT=${PHONE_PORT}`,
    `SUNDIAL_LABEL=${LABEL}`,
    ...(process.env.SUNDIAL_CHROME_PORT ? [`SUNDIAL_CHROME_PORT=${Number(process.env.SUNDIAL_CHROME_PORT)}`] : []),
    ...(sidecars ? [] : ['SUNDIAL_NATIVE_HELPERS=0']),
    ...(LABEL === 'dev.sundial.agent' && !flag('no-login-item') ? ['SUNDIAL_LOGIN_ITEM=1'] : []),
  ];
  fs.writeFileSync(path.join(HOME, 'app.env'), `${lines.join('\n')}\n`, { mode: 0o600 });
}

/**
 * An install from before 2026-09-26 has its bundle in the data folder. Moving
 * it — not rebuilding it — keeps its code signature, and with it the owner's
 * permission grants; the build after this only restages what changed.
 */
function moveAppOutOfHome() {
  if (APP === HOME_APP || !fs.existsSync(HOME_APP) || fs.existsSync(APP)) return;
  stopApp();
  run('mv', [HOME_APP, APP]);
  say(`  moved ${HOME_APP} to ${APP}; it is in your Applications now`);
}

/** The running app's pid, from the file it writes, if that process is still alive. */
function appPid() {
  try {
    const pid = Number(fs.readFileSync(path.join(HOME, '.daemon', 'app.pid'), 'utf8').trim());
    if (pid > 0) {
      process.kill(pid, 0);
      return pid;
    }
  } catch {
    /* not running */
  }
  return null;
}

/** Ask the app to quit (it stops the helpers and the web process itself) and wait for it. */
/**
 * Start the app. `open` hands the caller's environment to it, and Sundial.swift
 * lets that environment win over app.env, so a shell holding the SUNDIAL_* or
 * DSH_* of another install (a job, a test) would start this app on that
 * install's ports, label and dsh home. app.env defines what the app needs, so
 * none of them rides along.
 */
function openApp() {
  // The caller's install variables stay out (a test shell must not reconfigure
  // the live app); this install's own home goes in, so a bundle kept outside
  // its data folder still finds the right app.env instead of ~/.sundial.
  const env = { ...Object.fromEntries(Object.entries(process.env).filter(([key]) => !/^(SUNDIAL|DSH)_/.test(key))), SUNDIAL_HOME: HOME };
  return run('open', [APP], { env });
}

function stopApp() {
  const pid = appPid();
  if (!pid) return false;
  process.kill(pid, 'SIGTERM');
  for (let i = 0; i < 60 && appPid(); i++) sleep(250);
  return true;
}

/** Unload and delete this install's LaunchAgent, when the app takes over from it. */
function removeAgent() {
  if (agentLoaded()) {
    spawnSync('launchctl', ['bootout', `gui/${UID}/${LABEL}`], { stdio: 'ignore' });
    for (let i = 0; i < 40 && agentLoaded(); i++) sleep(250);
  }
  if (fs.existsSync(PLIST) && fs.readFileSync(PLIST, 'utf8').includes(HOME)) {
    fs.rmSync(PLIST, { force: true });
    say(`  removed the LaunchAgent ${LABEL}; the app starts Sundial now`);
  }
  // A launcher the agent started runs detached; the app starts its own.
  run(process.execPath, [path.join(REPO, 'apps', 'harness', 'bin', 'sundial-sidecars.js'), 'stop'], { env: { ...process.env, SUNDIAL_HOME: HOME }, check: false });
}

const agentLoaded = () => spawnSync('launchctl', ['print', `gui/${UID}/${LABEL}`], { stdio: 'ignore' }).status === 0;

const sleep = (ms) => Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms);

function loadAgent() {
  if (agentLoaded()) {
    spawnSync('launchctl', ['bootout', `gui/${UID}/${LABEL}`], { stdio: 'ignore' });
    // bootout returns before the job is gone; a bootstrap before then fails with EIO (5).
    for (let i = 0; i < 40 && agentLoaded(); i++) sleep(250);
  }
  fs.mkdirSync(path.dirname(PLIST), { recursive: true });
  fs.writeFileSync(PLIST, plistXml());
  run('launchctl', ['bootstrap', `gui/${UID}`, PLIST]);
}

async function waitForWeb(timeoutMs) {
  const url = `http://127.0.0.1:${WEB_PORT}/`;
  const until = Date.now() + timeoutMs;
  while (Date.now() < until) {
    try {
      const res = await fetch(url);
      if (res.status < 500) return true; // 401 is up: the page wants its sign-in link
    } catch {
      /* not up yet */
    }
    await new Promise((r) => setTimeout(r, 1000));
  }
  return false;
}

const makeDirs = () => {
  for (const dir of ['logs', '.daemon', 'models']) fs.mkdirSync(path.join(HOME, dir), { recursive: true, mode: 0o700 });
};

/** config.json and .env when missing, the shell hook and the dsh profile always. */
function writeHomeFiles() {
  if (writeIfMissing(path.join(HOME, 'config.json'), '{}\n')) say('  wrote config.json (every field is optional — see config.example.json)');
  if (writeIfMissing(path.join(HOME, '.env'), fs.readFileSync(path.join(REPO, 'env.example'), 'utf8'))) say('  wrote .env (add an LLM key here later; it is optional)');
  // The hook runs in your shell, which has no SUNDIAL_HOME: bake this install's folder in.
  const hook = fs.readFileSync(path.join(REPO, 'packages', 'sensors', 'shell-hook.zsh'), 'utf8').replaceAll('${SUNDIAL_HOME:-$HOME/.sundial}', HOME);
  fs.writeFileSync(path.join(HOME, 'shell-hook.zsh'), hook, { mode: 0o600 });
  writeProfile();
}

/**
 * What a self-contained Sundial.app runs before every start (REPO is then its
 * own Resources/app): claim the data folder and point the dsh profile at the
 * bundle, wherever it sits now. No build, no LaunchAgent, no app.env.
 */
function prepare() {
  claimHome();
  makeDirs();
  writeHomeFiles();
  writeMarker({ sidecars: process.env.SUNDIAL_NATIVE_HELPERS !== '0', mode: 'app', app: APP });
}

async function install() {
  const step = (n, text) => say(`\n[${n}/7] ${text}`);
  step(1, 'Checking what this Mac needs');
  if (!doctor()) fail('fix the items marked !! and run `sundial install` again.');

  step(2, `Claiming the data folder ${HOME}`);
  claimHome();
  makeDirs();

  if (!flag('skip-build')) {
    step(3, 'Installing dependencies and building (a few minutes the first time)');
    run('pnpm', ['install', '--frozen-lockfile'], { cwd: REPO });
    run('npx', ['tsc', '-b', 'tsconfig.json'], { cwd: REPO });
    step(4, 'Building the macOS sensors (Swift) into the data folder');
    moveAppOutOfHome();
    for (const script of ['swift.sh', 'app.sh']) run('bash', [path.join(REPO, 'apps', 'daemon', 'scripts', script)], { cwd: REPO, env: { ...process.env, SUNDIAL_HOME: HOME, SUNDIAL_BUNDLE_ID: BUNDLE_ID, SUNDIAL_APP_PATH: APP } });
  } else {
    step(3, 'Skipping build (--skip-build)');
    step(4, 'Skipping sensor build (--skip-build)');
  }

  step(5, 'Writing config, the web profile and the start script');
  writeHomeFiles();
  const sidecars = !flag('no-sidecars');
  const mode = process.platform === 'darwin' && !flag('no-app') ? 'app' : 'agent';
  writeStartScript({ sidecars });
  writeAppEnv({ sidecars });
  writeMarker({ sidecars, mode, app: APP });
  // A test install (its own label) leaves the owner's Claude settings alone unless asked.
  if (flag('claude-hooks') || (LABEL === 'dev.sundial.agent' && !flag('no-claude-hooks'))) addClaudeHooks();
  if (flag('claude-context') || (LABEL === 'dev.sundial.agent' && !flag('no-claude-context'))) addClaudeContext();

  if (flag('no-launchagent')) {
    step(6, `Not starting Sundial (--no-launchagent). Start by hand: ${mode === 'app' ? `open ${APP}` : `zsh ${path.join(HOME, 'start.sh')}`}`);
    return;
  }
  if (mode === 'app') {
    step(6, 'Starting the Sundial app (it adds itself to Login Items)');
    removeAgent();
    stopApp();
    openApp();
  } else {
    step(6, `Installing the LaunchAgent ${LABEL} (starts Sundial at login)`);
    loadAgent();
  }

  step(7, `Waiting for http://127.0.0.1:${WEB_PORT}`);
  if (!(await waitForWeb(Number(option('timeout') ?? 120) * 1000))) {
    fail(`the web client did not answer. Read ${path.join(HOME, 'logs', 'sundial.log')}.`);
  }
  say(`\nSundial is running: http://127.0.0.1:${WEB_PORT}  (setup: http://127.0.0.1:${WEB_PORT}/setup)`);
  say('Next: the page walks you through the macOS permissions. Nothing is sent anywhere until you add an LLM key.');
  say(`Optional shell history: add this line to ~/.zshrc\n  [ -f "${path.join(HOME, 'shell-hook.zsh')}" ] && source "${path.join(HOME, 'shell-hook.zsh')}"`);
  await offerMcp();
  if (!flag('no-open')) openBrowser();
}

/**
 * Claude Code reads the record through Sundial's MCP server; that is the
 * quickest way to a first useful answer. Asked, never assumed: it changes the
 * owner's Claude config. Without a terminal (CI, a script) or without
 * `claude`, the command is printed instead.
 */
async function offerMcp() {
  const cmd = ['mcp', 'add', 'sundial', '--scope', 'user', '-e', `SUNDIAL_HOME=${HOME}`, '--', process.execPath, path.join(REPO, 'packages', 'mcp', 'bin', 'sundial-mcp.js')];
  const shown = `claude ${cmd.map((a) => (/[\s"'$]/.test(a) ? `"${a}"` : a)).join(' ')}`;
  if (!has('claude') || !process.stdin.isTTY || flag('no-mcp')) {
    say(`\nUse Sundial from Claude Code:\n  ${shown}`);
    return;
  }
  if (spawnSync('claude', ['mcp', 'get', 'sundial'], { stdio: 'ignore' }).status === 0) {
    say('\nClaude Code already has an MCP server named sundial. Left as it is.');
    return;
  }
  const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
  const answer = (await rl.question('\nAdd Sundial to Claude Code, so Claude can read your record? [y/N] ')).trim().toLowerCase();
  rl.close();
  if (answer !== 'y' && answer !== 'yes') {
    say(`Skipped. To add it later:\n  ${shown}`);
    return;
  }
  const result = run('claude', cmd, { check: false });
  say(result.status === 0 ? 'Added. Restart Claude Code, then ask it what you worked on this week.' : `That did not work. Run it yourself:\n  ${shown}`);
}

/**
 * The sign-in URL: dsh prints `http://127.0.0.1:<port>/?token=…` when it starts,
 * and opening it once gives this browser a session cookie. The log lives in the
 * 0700 data folder, so only this user can read the token.
 */
function signInUrl() {
  try {
    const log = fs.readFileSync(path.join(HOME, 'logs', 'sundial.log'), 'utf8');
    const urls = log.match(new RegExp(`http://127\\.0\\.0\\.1:${WEB_PORT}/\\?token=[A-Za-z0-9_-]+`, 'g'));
    return urls ? urls[urls.length - 1] : null;
  } catch {
    return null;
  }
}

function openBrowser() {
  const url = signInUrl();
  if (!url) fail(`no sign-in URL in ${path.join(HOME, 'logs', 'sundial.log')} yet. Is Sundial running? Try \`sundial status\`.`);
  spawnSync('open', [url]);
  say(`Opened ${url.replace(/token=.*/, 'token=…')} (it signs this browser in, then shows the setup page).`);
}

// ---------------------------------------------------------------------------
// Claude Code hooks: report-only. Each event runs packages/sensors/claude-hook.mjs,
// which appends one whitelisted line to $SUNDIAL_HOME/.daemon/claude-hooks.jsonl
// and prints nothing, so it never approves, denies or adds context (the one
// exception, the SessionStart context hook, is its own entry below). The entries
// are Sundial's by their command (the hook file plus this install's folder);
// nothing else in the owner's settings is read into or changed.

const CLAUDE_DIR = process.env.CLAUDE_CONFIG_DIR || path.join(os.homedir(), '.claude');
const CLAUDE_SETTINGS = path.join(CLAUDE_DIR, 'settings.json');
const HOOK_SCRIPT = path.join(REPO, 'packages', 'sensors', 'claude-hook.mjs');
/** Event → matcher (null: every one). SessionEnd runs in the foreground: Claude is exiting, and a background child may not outlive it. */
const CLAUDE_HOOK_EVENTS = {
  SessionStart: null,
  SessionEnd: null,
  UserPromptSubmit: null,
  Notification: null,
  Stop: null,
  StopFailure: null,
  PreCompact: null,
  PostToolUse: 'Edit|Write|MultiEdit|NotebookEdit',
};
const shq = (s) => `'${s.replaceAll("'", "'\\''")}'`;
const hookCommand = () => `${shq(SIDECAR_NODE)} ${shq(HOOK_SCRIPT)} ${shq(HOME)}`;
const isOurHook = (h) => typeof h?.command === 'string' && h.command.includes('claude-hook.mjs') && h.command.endsWith(` ${shq(HOME)}`);

function readClaudeSettings() {
  if (!fs.existsSync(CLAUDE_SETTINGS)) return {};
  try {
    const parsed = JSON.parse(fs.readFileSync(CLAUDE_SETTINGS, 'utf8'));
    if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) return parsed;
  } catch {}
  fail(`${CLAUDE_SETTINGS} is not a JSON object. Left as it is; no hooks were changed.`);
}

/** The settings without Sundial's entries for this install (`is` picks which). Groups and events left empty by it are dropped. */
function withoutOurHooks(settings, is = isOurHook) {
  if (!settings.hooks || typeof settings.hooks !== 'object') return settings;
  const hooks = {};
  for (const [event, groups] of Object.entries(settings.hooks)) {
    if (!Array.isArray(groups)) {
      hooks[event] = groups;
      continue;
    }
    const kept = groups
      .map((g) => (Array.isArray(g?.hooks) && g.hooks.some(is) ? { ...g, hooks: g.hooks.filter((h) => !is(h)) } : g))
      .filter((g) => !(Array.isArray(g?.hooks) && g.hooks.length === 0));
    if (kept.length > 0) hooks[event] = kept;
  }
  // Rebuilt key by key, so `hooks` keeps its place and the rest of the file its order.
  return Object.fromEntries(Object.entries(settings).flatMap(([k, v]) => (k !== 'hooks' ? [[k, v]] : Object.keys(hooks).length > 0 ? [[k, hooks]] : [])));
}

function writeClaudeSettings(settings) {
  fs.mkdirSync(CLAUDE_DIR, { recursive: true });
  const mode = fs.existsSync(CLAUDE_SETTINGS) ? fs.statSync(CLAUDE_SETTINGS).mode & 0o777 : 0o600;
  const tmp = `${CLAUDE_SETTINGS}.sundial-${process.pid}`;
  fs.writeFileSync(tmp, `${JSON.stringify(settings, null, 2)}\n`, { mode });
  fs.renameSync(tmp, CLAUDE_SETTINGS);
}

/** Add (or refresh) Sundial's hooks. Idempotent: a second run leaves the file byte-for-byte the same. */
function addClaudeHooks() {
  const settings = withoutOurHooks(readClaudeSettings());
  const hooks = { ...(settings.hooks ?? {}) };
  for (const [event, matcher] of Object.entries(CLAUDE_HOOK_EVENTS)) {
    const hook = { type: 'command', command: hookCommand(), timeout: 10, ...(event === 'SessionEnd' ? {} : { async: true }) };
    hooks[event] = [...(Array.isArray(hooks[event]) ? hooks[event] : []), { ...(matcher ? { matcher } : {}), hooks: [hook] }];
  }
  writeClaudeSettings({ ...settings, hooks });
  say(`  Claude Code hooks (report-only) in ${CLAUDE_SETTINGS}: ${Object.keys(CLAUDE_HOOK_EVENTS).join(', ')}`);
}

/** Remove exactly Sundial's hooks for this install (`is` picks which). True when there were any. */
function removeClaudeHooks(is = isOurHook) {
  if (!fs.existsSync(CLAUDE_SETTINGS)) return false;
  const before = readClaudeSettings();
  const after = withoutOurHooks(before, is);
  if (JSON.stringify(after) === JSON.stringify(before)) return false;
  writeClaudeSettings(after);
  return true;
}

function claudeHooks() {
  if (flag('remove')) return say(removeClaudeHooks() ? `Removed Sundial's Claude Code hooks from ${CLAUDE_SETTINGS}.` : 'No Sundial hooks to remove.');
  addClaudeHooks();
}

// lane E (#11): the SessionStart context hook, the ONE Sundial hook that adds
// context (owner-approved 2026-09-29, for SessionStart only). It is its own
// entry, so it goes in and out without touching the report-only hooks.
const CONTEXT_SCRIPT = path.join(REPO, 'packages', 'sensors', 'claude-context.mjs');
const isOurContextHook = (h) => typeof h?.command === 'string' && h.command.includes('claude-context.mjs') && h.command.endsWith(` ${shq(HOME)}`);
const isAnyOurHook = (h) => isOurHook(h) || isOurContextHook(h);

/** Add (or refresh) the context hook. Not async: Claude reads a SessionStart hook's stdout only when it waits for it. It gives up by itself after 450 ms. */
function addClaudeContext() {
  const settings = withoutOurHooks(readClaudeSettings(), isOurContextHook);
  const hooks = { ...(settings.hooks ?? {}) };
  const hook = { type: 'command', command: `${shq(SIDECAR_NODE)} ${shq(CONTEXT_SCRIPT)} ${shq(HOME)}`, timeout: 2 };
  hooks.SessionStart = [...(Array.isArray(hooks.SessionStart) ? hooks.SessionStart : []), { hooks: [hook] }];
  writeClaudeSettings({ ...settings, hooks });
  say(`  Claude Code SessionStart context hook in ${CLAUDE_SETTINGS} (off: sundial claude-context --remove, or privacy.claudeContext false)`);
}

function claudeContext() {
  if (flag('remove')) return say(removeClaudeHooks(isOurContextHook) ? `Removed Sundial's SessionStart context hook from ${CLAUDE_SETTINGS}.` : 'No Sundial context hook to remove.');
  addClaudeContext();
}

// ---------------------------------------------------------------------------
// uninstall

function uninstall() {
  assertSafeHome();
  const marker = readMarker();
  if (!marker) {
    fail(`${HOME} has no Sundial install marker for this folder (${MARKER}). Nothing was removed.`);
  }
  const plist = marker.plist ?? PLIST;
  const label = marker.label ?? LABEL;
  const targets = [HOME];
  // An app bundle outside the folder is removed only when it is this install's (its bundle id says so).
  const app = marker.app && marker.app !== path.join(HOME, 'Sundial.app') ? marker.app : null;
  const appOurs = app !== null && fs.existsSync(path.join(app, 'Contents', 'Info.plist')) && spawnSync('plutil', ['-extract', 'CFBundleIdentifier', 'raw', path.join(app, 'Contents', 'Info.plist')], { encoding: 'utf8' }).stdout.trim() === BUNDLE_ID;
  if (appOurs) targets.push(app);
  const plistOurs = fs.existsSync(plist) && fs.readFileSync(plist, 'utf8').includes(`<string>${label}</string>`) && fs.readFileSync(plist, 'utf8').includes(HOME);
  if (plistOurs) targets.push(plist);

  if (!flag('yes')) {
    say('This would remove:');
    say(`  LaunchAgent ${label}${plistOurs ? ` (${plist})` : ' (not installed)'}`);
    for (const t of targets.slice(0, 1)) say(`  ${t}  — the data folder: database, config, .env, logs`);
    if (appOurs) say(`  ${app}  — the app`);
    if (fs.existsSync(CLAUDE_SETTINGS) && JSON.stringify(withoutOurHooks(readClaudeSettings(), isAnyOurHook)) !== JSON.stringify(readClaudeSettings())) say(`  Sundial's hooks in ${CLAUDE_SETTINGS} (nothing else in it)`);
    if (backupsOutside()) say(`\nKept: ${backupsOutside()} — daily copies of the whole record. Remove them by hand if you want them gone.`);
    say('\nRun `sundial uninstall --yes` to do it. The repository folder is not touched.');
    return;
  }
  if (spawnSync('launchctl', ['print', `gui/${UID}/${label}`], { stdio: 'ignore' }).status === 0) {
    spawnSync('launchctl', ['bootout', `gui/${UID}/${label}`], { stdio: 'inherit' });
  }
  // The app stops its own helpers and web process; its Login Items entry goes with the bundle.
  stopApp();
  // Stop a sidecar launcher this install started (its pid file lives in the folder).
  try {
    const pid = Number(fs.readFileSync(path.join(HOME, '.daemon', 'sidecars.pid'), 'utf8').trim());
    if (pid > 0) process.kill(pid, 'SIGTERM');
  } catch {
    /* not running */
  }
  if (plistOurs) fs.rmSync(plist, { force: true });
  if (appOurs) fs.rmSync(app, { recursive: true, force: true });
  if (removeClaudeHooks(isAnyOurHook)) say(`Removed Sundial's Claude Code hooks from ${CLAUDE_SETTINGS}.`);
  fs.rmSync(HOME, { recursive: true, force: true });
  say(`Removed ${targets.join(' and ')}.`);
  say('macOS keeps permission grants per app. To clear them too, run:');
  say(`  tccutil reset All ${BUNDLE_ID}`);
  say('If you added the shell hook line to ~/.zshrc, remove it by hand.');
  if (backupsOutside()) say(`Kept: ${backupsOutside()} — daily copies of the whole record (up to 7). To remove them: rm -rf '${backupsOutside()}'`);
}

/** The daily copies, when they live outside the data folder (the owner's install: ~/sundial-backups/daily). Same rule as packages/helpers/src/backup-dir.ts. */
function backupsOutside() {
  const dir = path.join(os.homedir(), 'sundial-backups', 'daily');
  return path.resolve(HOME) === path.join(os.homedir(), '.sundial') && fs.existsSync(dir) ? dir : null;
}

// ---------------------------------------------------------------------------
// migrate: copy an install from before the rename (~/.gnomon + ~/.dsh) here.

function sqliteBackup(src, dest) {
  run('sqlite3', [src, `.backup '${dest.replaceAll("'", "''")}'`], { quiet: true });
  // A copy of a WAL database is still marked WAL, and a read-only open of it
  // fails without its -shm. Make the copy one self-contained file, then count.
  const rows = run('sqlite3', [dest, 'pragma journal_mode=delete;', 'select count(*) from signals;'], { quiet: true }).stdout.trim().split('\n').pop();
  return Number(rows);
}

function copyTree(src, dest) {
  if (!fs.existsSync(src)) return false;
  fs.cpSync(src, dest, { recursive: true, dereference: false, errorOnExist: false, force: false });
  return true;
}

function migrate() {
  const from = path.resolve(option('from') ?? path.join(os.homedir(), '.gnomon'));
  const dshFrom = path.resolve(option('dsh-from') ?? path.join(os.homedir(), '.dsh'));
  const db = ['gnomon-harness.db', 'sundial.db'].map((n) => path.join(from, n)).find((p) => fs.existsSync(p));
  if (!db) fail(`no database found in ${from} (looked for gnomon-harness.db).`);
  if (path.resolve(from) === path.resolve(HOME)) fail('--from and SUNDIAL_HOME are the same folder.');
  if (fs.existsSync(path.join(HOME, 'sundial.db'))) fail(`${HOME} already has a sundial.db. Migrate refuses to overwrite it.`);

  // 1. Back up the source first.
  const stamp = new Date().toISOString().replace(/[:.]/g, '-');
  const backup = path.join(os.homedir(), 'sundial-backups', `${stamp}-pre-migrate`);
  fs.mkdirSync(backup, { recursive: true, mode: 0o700 });
  const backedUp = sqliteBackup(db, path.join(backup, path.basename(db)));
  for (const f of ['config.json', '.env']) if (fs.existsSync(path.join(from, f))) fs.copyFileSync(path.join(from, f), path.join(backup, f));
  say(`Backed up ${db} (${backedUp} signals) and config to ${backup}`);

  // 2. Copy — never move — into the new folder.
  claimHome();
  for (const dir of ['logs', '.daemon', 'models']) fs.mkdirSync(path.join(HOME, dir), { recursive: true, mode: 0o700 });
  const copied = sqliteBackup(db, path.join(HOME, 'sundial.db'));
  fs.chmodSync(path.join(HOME, 'sundial.db'), 0o600);
  say(`Copied the database: ${copied} signals${copied === backedUp ? '' : ' — COUNT DIFFERS from the backup, check before switching'}`);

  if (fs.existsSync(path.join(from, 'config.json'))) {
    // Paths inside config.json (model files, for one) name the old folder.
    const config = JSON.parse(fs.readFileSync(path.join(from, 'config.json'), 'utf8').replaceAll(from, HOME));
    // Two captures became opt-in with the rename; an old install had them on.
    config.privacy = { mail: true, ...config.privacy };
    config.browser = { pageText: true, ...config.browser };
    // Three experiments became switches too; the old install ran all three.
    config.experiments = { forecasting: true, gateFeatures: true, presence: true, ...config.experiments };
    fs.writeFileSync(path.join(HOME, 'config.json'), `${JSON.stringify(config, null, 2)}\n`, { mode: 0o600 });
  }
  if (fs.existsSync(path.join(from, '.env'))) {
    let env = fs.readFileSync(path.join(from, '.env'), 'utf8').replace(/^(\s*(?:export\s+)?)GNOMON_/gm, '$1SUNDIAL_');
    // The old install always listened for the phone; the new one only when asked.
    if (fs.existsSync(path.join(from, '.daemon', 'api-token')) && !/^SUNDIAL_PHONE_INGEST=/m.test(env)) env += '\nSUNDIAL_PHONE_INGEST=1\n';
    fs.writeFileSync(path.join(HOME, '.env'), env, { mode: 0o600 });
  }
  copyTree(path.join(from, 'models'), path.join(HOME, 'models'));
  for (const f of ['api-token', 'device-id', 'learned-sensitive-apps.json', 'archived-sessions.json', 'session-titles.json', 'companion-session.json', 'work-session.json']) {
    const src = path.join(from, '.daemon', f);
    if (fs.existsSync(src)) fs.copyFileSync(src, path.join(HOME, '.daemon', f));
  }
  // Conversations live in the dsh home.
  fs.mkdirSync(DSH_HOME, { recursive: true, mode: 0o700 });
  for (const d of ['sessions', 'attachments', 'storages', 'session-log-backups']) copyTree(path.join(dshFrom, d), path.join(DSH_HOME, d));
  // The model route was `tensorx` before v0.2 and is `openai` now. The old id
  // still answers (an alias, for conversations recorded under it), but the
  // saved default should name the route the picker shows.
  if (fs.existsSync(path.join(dshFrom, 'settings.yaml'))) {
    const settings = fs.readFileSync(path.join(dshFrom, 'settings.yaml'), 'utf8').replace(/^(\s*provider:\s*)(["']?)tensorx\2\s*$/gm, '$1openai');
    fs.writeFileSync(path.join(DSH_HOME, 'settings.yaml'), settings, { mode: 0o600 });
  }
  if (fs.existsSync(path.join(dshFrom, 'session-index.sqlite'))) {
    run('sqlite3', [path.join(dshFrom, 'session-index.sqlite'), `.backup '${path.join(DSH_HOME, 'session-index.sqlite')}'`], { quiet: true });
  }
  writeMarker({ migratedFrom: from, migratedAt: new Date().toISOString(), backup });

  say(`\nCopied ${from} and ${dshFrom} into ${HOME}. Nothing in the old folders was changed.`);
  say('\nNext:');
  say('  1. sundial install        (builds the Sundial app bundle and its LaunchAgent)');
  say('  2. Stop the old one only when the new one works:');
  say('       launchctl bootout gui/$(id -u)/dev.gnomon.sundial');
  say('\nThe new app has a new identity, so macOS asks for every permission again.');
  say('Grant these to "Sundial" in System Settings → Privacy & Security:');
  for (const p of ['Accessibility', 'Screen Recording (only if OCR is on)', 'Input Monitoring', 'Calendars', 'Contacts', 'Microphone (only if hearing is on)', 'Notifications']) say(`  - ${p}`);
  say('and Automation for "Sundial Browser Helper" (asked the first time it reads your browser tab).');
}

// ---------------------------------------------------------------------------
// status / start / stop

function status() {
  const marker = readMarker();
  say(`home      ${HOME} ${marker ? `(installed ${marker.createdAt})` : '(no install here)'}`);
  if (!marker && fs.existsSync(path.join(os.homedir(), '.gnomon')) && !process.env.SUNDIAL_HOME) {
    say('          an install from before the rename is in ~/.gnomon — see `sundial migrate`');
  }
  if (appMode()) say(`app       ${APP} ${appPid() ? `running (pid ${appPid()})` : 'not running'}`);
  else say(`agent     ${LABEL} ${agentLoaded() ? 'loaded' : 'not loaded'}`);
  // lane H (H7): a bundle in the data folder beside the real app is a stray from a build run without SUNDIAL_APP_PATH.
  if (appMode() && path.resolve(APP) !== path.resolve(HOME_APP) && fs.existsSync(HOME_APP)) {
    say(`  !!      a second Sundial.app is in ${HOME_APP}; the app runs from ${APP}. It is a stray from a build; delete it when Sundial is stopped.`);
  }
  for (const c of installChecks()) if (!c.ok) say(`  !!      ${c.name} is missing\n          ${c.fix}`);
  const r = spawnSync('curl', ['-s', '-o', '/dev/null', '-w', '%{http_code}', `http://127.0.0.1:${WEB_PORT}/`], { encoding: 'utf8' });
  say(`web       http://127.0.0.1:${WEB_PORT} → ${r.stdout || 'no answer'}`);
  const db = path.join(HOME, 'sundial.db');
  if (fs.existsSync(db)) {
    const q = spawnSync('sqlite3', ['-readonly', db, 'select count(*), max(captured_at) from signals;'], { encoding: 'utf8' });
    say(`database  ${db} (${(q.stdout || '?').trim().replace('|', ' signals, last ')})`);
  }
  spawnSync(process.execPath, [path.join(REPO, 'apps', 'harness', 'bin', 'sundial-sidecars.js'), 'status'], { stdio: 'inherit', env: { ...process.env, SUNDIAL_HOME: HOME } });
}

const commands = {
  install,
  prepare,
  uninstall,
  migrate,
  status,
  doctor: () => process.exit(doctor() ? 0 : 1),
  start: () => {
    if (appMode()) return appPid() ? say('Sundial is already running.') : openApp();
    if (agentLoaded()) return run('launchctl', ['kickstart', `gui/${UID}/${LABEL}`]);
    if (!fs.existsSync(PLIST)) fail(`there is no LaunchAgent (${PLIST}). Installed with --no-launchagent? Start by hand: zsh ${path.join(HOME, 'start.sh')}`);
    return run('launchctl', ['bootstrap', `gui/${UID}`, PLIST]);
  },
  // The helpers' launcher runs detached, so stopping the agent alone leaves it
  // capturing into .daemon/ with nothing reading. Stop it too.
  stop: () => {
    if (appMode()) return say(stopApp() ? 'Stopped Sundial.' : 'Sundial was not running.');
    run('launchctl', ['bootout', `gui/${UID}/${LABEL}`], { check: false });
    run(process.execPath, [path.join(REPO, 'apps', 'harness', 'bin', 'sundial-sidecars.js'), 'stop'], { env: { ...process.env, SUNDIAL_HOME: HOME }, check: false });
  },
  restart: () => {
    if (!appMode()) return run('launchctl', ['kickstart', '-k', `gui/${UID}/${LABEL}`]);
    stopApp();
    openApp();
  },
  open: openBrowser,
  'claude-hooks': claudeHooks,
  'claude-context': claudeContext,
  mcp: () => run(process.execPath, [path.join(REPO, 'packages', 'mcp', 'bin', 'sundial-mcp.js')], { env: { ...process.env, SUNDIAL_HOME: HOME } }),
};

const command = process.argv[2];
if (!commands[command]) {
  say(`Usage: sundial <command>

  install     check prerequisites, build, write ${HOME}, start at login
                --no-open  --no-sidecars  --no-launchagent  --no-mcp  --skip-build
                --no-app (a LaunchAgent instead of the Mac app)  --no-login-item
                --no-claude-hooks  --claude-hooks (a test install adds none unless asked)
                --no-claude-context  --claude-context (the same, for the SessionStart context hook)
                --timeout <seconds>  (how long to wait for the web client, default 120)
  status      what is installed and running
  doctor      check prerequisites only
  open        sign this browser in and open Sundial
  start|stop|restart
  mcp         run the read-only MCP server over stdio (for Claude Code etc.)
  migrate     copy an old ~/.gnomon install into ${HOME} (never moves)
                --from <dir>  --dsh-from <dir>
  claude-hooks  add Sundial's report-only hooks to Claude Code's settings.json
                --remove  (take exactly Sundial's entries out again)
  claude-context  add the SessionStart hook that gives a new Claude session Gnomon's
                context for its folder (at most 5 lines); --remove takes it out
  uninstall   remove what install wrote (dry run without --yes)

Environment: SUNDIAL_HOME, SUNDIAL_LABEL, SUNDIAL_WEB_PORT, SUNDIAL_PHONE_PORT, SUNDIAL_CHROME_PORT, SUNDIAL_SIDECAR_NODE`);
  process.exit(command ? 2 : 0);
}
await commands[command]();
