{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "@sundial/helpers/*": [
        "../helpers/src/*"
      ],
      "@sundial/db/*": [
        "../db/src/*"
      ],
      "@sundial/memory/*": [
        "../memory/src/*"
      ],
      "@sundial/llm/*": [
        "../llm/src/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "references": [
    {
      "path": "../helpers"
    },
    {
      "path": "../db"
    },
    {
      "path": "../memory"
    },
    {
      "path": "../llm"
    }
  ]
}
