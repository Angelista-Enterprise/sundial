{
  "name": "@sundial/kernel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@sundial/db": "workspace:*",
    "@sundial/helpers": "workspace:*",
    "@sundial/llm": "workspace:*",
    "@sundial/memory": "workspace:*",
    "zod": "^4"
  },
  "devDependencies": {
    "@libsql/client": "^0.14.0",
    "drizzle-orm": "^0.45.2"
  }
}
