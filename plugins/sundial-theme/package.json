{
  "name": "@sundial/dsh-theme",
  "version": "0.0.1",
  "type": "module",
  "description": "Cordis plugin: Gnomon's own web client at / \u2014 the shell (sessions, canvas, approvals, the model), Today as its zero state, the Ledger and the Instruments, and the routes behind them.",
  "main": "index.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./host/*": "./host/*",
    "./shell/*": "./shell/*"
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@sundial/db": "workspace:*",
    "@sundial/helpers": "workspace:*",
    "@sundial/kernel": "workspace:*",
    "@sundial/nodus": "workspace:*"
  }
}
